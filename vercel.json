{
  "version": 2,
  "buildCommand": "npm run build && npm run build --prefix backend",
  "installCommand": "npm install && npm install --prefix backend",
  "env": {
    "NODE_ENV": "production"
  },
  "builds": [
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.ts"
    },
    {
      "src": "/api",
      "dest": "backend/api/index.ts"
    },
    {
      "src": "/(.*\\.[a-zA-Z0-9]+)$",
      "dest": "/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ]
}
